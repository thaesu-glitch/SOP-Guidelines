{
  "name": "sop-boq-vendor-app",
  "version": "0.1.0",
  "private": true,
  "description": "BOQ Budget Review, Vendor Quotation Comparison and Approved Vendor Dashboard",
  "workspaces": ["server", "client"],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
